; Engine configuration file.
; Two Keepers - Gardens of Cyrus
; Godot 4.3 (stable)
;
; Everything the game needs is generated in code, so this project contains no
; imported art assets. Open the folder in Godot 4.3 and press F5.

config_version=5

[application]

config/name="Two Keepers - Gardens of Cyrus"
config/description="Local two-player cooperative puzzle platformer about two apprentice keepers restoring the garden canals of Pasargadae."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/boot_splash/bg_color=Color(0.06, 0.07, 0.09, 1)
config/boot_splash/show_image=false

[autoload]

; Settings loads first: Controls reads the saved input method during _ready.
Settings="*res://src/autoload/settings.gd"
Controls="*res://src/autoload/controls.gd"
GameState="*res://src/autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1800.0
2d/default_gravity_vector=Vector2(0, 1)

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.09, 1)
